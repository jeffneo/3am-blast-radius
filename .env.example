# 3 a.m. Blast Radius: local configuration. Secret: never commit (see .gitignore).
# Copy .env.example to create one. Compose reads this file automatically.

# --- Neo4j -------------------------------------------------------------------
# Enterprise 2026.x for local development (GDS + Enterprise Studio). The lab
# itself targets Neo4j 5.26: build/verify.py tests against that separately.
NEO4J_IMAGE=neo4j:2026.08.1-enterprise
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-me
NEO4J_ACCEPT_LICENSE_AGREEMENT=eval
# The lab database. Made the server's DEFAULT database, so Browser, Studio and
# a bare cypher-shell all open on it. Applies on first boot of a fresh volume.
NEO4J_DATABASE=blastradius

# Host ports. Distinct from the other demos' defaults so they can run together.
NEO4J_HTTP_PORT=7481
NEO4J_BOLT_PORT=7694
NEO4J_HEAP=1G
NEO4J_PAGECACHE=512M

# --- Neo4j Enterprise Studio ---------------------------------------------------
NES_PORT=8083
# Service account Studio uses for its asset store (saved queries, dashboards).
NES_SERVICE_PASSWORD=change-me

# --- Licenses (signed JWTs, gitignored) -----------------------------------------
GDS_LICENSE_PATH=./gds.license
NES_LICENSE_PATH=./nes.license
