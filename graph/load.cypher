// ===========================================================================
//  3 a.m. Blast Radius: the graph                       GENERATED, do not edit
//
//  Regenerate with:  python3 build/generate.py        (seeded: same output every time)
//
//  A fully fictional service-dependency graph for a large retail bank. Nothing
//  here describes any real institution's architecture. Every name, team,
//  incident, change and customer count is invented.
//
//    1094 nodes: 232 components, 25 teams, 30 journeys, 228 incidents, 455 changes, 71 runbooks, 34 certificates, 19 alerts. 617 dependencies.
//
//  Pure Cypher: no APOC, no GDS, no files. Idempotent: every write is a MERGE on
//  a unique key, so re-running changes nothing. Statements are batched
//  (150 rows each), so none is large.
//
//    cypher-shell -d <database> -f graph/load.cypher
//
//  "Tonight" is 2026-09-30T03:07:00Z. The queries use that fixed time, never now().
//
//  The data is deliberately messy: see build/generate.py for the list, and
//  graph/MODEL.md for what each kind of mess is for.
// ===========================================================================

CREATE CONSTRAINT component_key IF NOT EXISTS FOR (n:Component) REQUIRE n.name IS UNIQUE;

CREATE CONSTRAINT team_key IF NOT EXISTS FOR (n:Team) REQUIRE n.name IS UNIQUE;

CREATE CONSTRAINT journey_key IF NOT EXISTS FOR (n:Journey) REQUIRE n.name IS UNIQUE;

CREATE CONSTRAINT incident_key IF NOT EXISTS FOR (n:Incident) REQUIRE n.id IS UNIQUE;

CREATE CONSTRAINT change_key IF NOT EXISTS FOR (n:Change) REQUIRE n.id IS UNIQUE;

CREATE CONSTRAINT runbook_key IF NOT EXISTS FOR (n:Runbook) REQUIRE n.id IS UNIQUE;

CREATE CONSTRAINT alert_key IF NOT EXISTS FOR (n:Alert) REQUIRE n.id IS UNIQUE;

CREATE CONSTRAINT certificate_key IF NOT EXISTS FOR (n:Certificate) REQUIRE n.name IS UNIQUE;

CREATE INDEX change_time IF NOT EXISTS FOR (n:Change) ON (n.deployed_at);

CREATE INDEX incident_time IF NOT EXISTS FOR (n:Incident) ON (n.started_at);

// ---- teams ----
UNWIND [
  {name: 'Digital Channels', pager: 'digital-oncall', status: 'active', disbanded_on: null},
  {name: 'Identity & Access', pager: 'iam-oncall', status: 'active', disbanded_on: null},
  {name: 'Payments Platform', pager: 'payments-oncall', status: 'active', disbanded_on: null},
  {name: 'Cards', pager: 'cards-oncall', status: 'active', disbanded_on: null},
  {name: 'Core Banking', pager: 'core-oncall', status: 'active', disbanded_on: null},
  {name: 'Data Platform', pager: 'dataplat-oncall', status: 'active', disbanded_on: null},
  {name: 'Lending', pager: 'lending-oncall', status: 'active', disbanded_on: null},
  {name: 'Wealth', pager: 'wealth-oncall', status: 'active', disbanded_on: null},
  {name: 'Fraud & Risk', pager: 'risk-oncall', status: 'active', disbanded_on: null},
  {name: 'Messaging Platform', pager: 'messaging-oncall', status: 'active', disbanded_on: null},
  {name: 'Observability', pager: 'obs-oncall', status: 'active', disbanded_on: null},
  {name: 'Treasury Tech', pager: 'treasury-oncall', status: 'active', disbanded_on: null},
  {name: 'Merchant Services', pager: 'merchant-oncall', status: 'active', disbanded_on: null},
  {name: 'Customer Support Tech', pager: 'support-oncall', status: 'active', disbanded_on: null},
  {name: 'Compliance Tech', pager: 'compliance-oncall', status: 'active', disbanded_on: null},
  {name: 'Security Engineering', pager: 'secops-oncall', status: 'active', disbanded_on: null},
  {name: 'Cloud Platform', pager: 'cloud-oncall', status: 'active', disbanded_on: null},
  {name: 'Data Science', pager: 'ds-oncall', status: 'active', disbanded_on: null},
  {name: 'Marketing Tech', pager: 'martech-oncall', status: 'active', disbanded_on: null},
  {name: 'Mobile Platform', pager: 'mobile-oncall', status: 'active', disbanded_on: null},
  {name: 'Branch & ATM Tech', pager: 'branch-oncall', status: 'active', disbanded_on: null},
  {name: 'Corporate Banking', pager: 'corpbank-oncall', status: 'active', disbanded_on: null},
  {name: 'Internal Tools', pager: null, status: 'active', disbanded_on: null},
  {name: 'Legacy Platform', pager: null, status: 'disbanded', disbanded_on: '2025-03-31'},
  {name: 'Shared Services', pager: null, status: 'disbanded', disbanded_on: '2025-08-29'}
] AS row
MERGE (t:Team {name: row.name})
SET t.pager = row.pager, t.status = row.status,
    t.disbanded_on = CASE WHEN row.disbanded_on IS NULL THEN null ELSE date(row.disbanded_on) END;

