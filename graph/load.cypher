  {cert: 'mtls.fee-engine', svc: 'gl-export-batch'},
  {cert: 'mtls.fee-engine', svc: 'velocity-rules-svc'},
  {cert: 'mtls.entitlements-svc', svc: 'entitlements-svc'},
  {cert: 'mtls.metrics-gateway', svc: 'metrics-gateway'},
  {cert: 'mtls.metrics-gateway', svc: 'container-registry'},
  {cert: 'mtls.model-scoring-svc', svc: 'model-scoring-svc'},
  {cert: 'mtls.model-scoring-svc', svc: 'merchant-onboarding-svc'},
  {cert: 'mtls.container-registry', svc: 'container-registry'},
  {cert: 'mtls.container-registry', svc: 'audience-builder'},
  {cert: 'mtls.trade-order-svc', svc: 'trade-order-svc'},
  {cert: 'mtls.trade-order-svc', svc: 'risk-based-auth-svc'},
  {cert: 'mtls.fx-quote-svc', svc: 'fx-quote-svc'},
  {cert: 'mtls.event-schema-registry', svc: 'event-schema-registry'},
  {cert: 'mtls.event-schema-registry', svc: 'deep-link-svc'},
  {cert: 'mtls.sso-federation-svc', svc: 'sso-federation-svc'},
  {cert: 'mtls.batch-scheduler', svc: 'batch-scheduler'},
  {cert: 'mtls.batch-scheduler', svc: 'transaction-monitoring-svc'},
  {cert: 'mtls.batch-scheduler', svc: 'feature-flag-svc'},
  {cert: 'mtls.feature-flag-svc', svc: 'feature-flag-svc'},
  {cert: 'mtls.feature-flag-svc', svc: 'regulatory-reporting-batch'},
  {cert: 'mtls.loan-servicing-svc', svc: 'loan-servicing-svc'},
  {cert: 'mtls.loan-servicing-svc', svc: 'cash-forecast-svc'}
] AS row
MATCH (c:Certificate {name: row.cert}), (s:Service {name: row.svc})
MERGE (s)-[:USES_CERT]->(c);

// ---- the last time a certificate took the estate down ----
UNWIND [
  {id: 'INC-0990', at: '2025-10-10T03:12:00Z', sev: 1, title: 'Internal TLS failures across the estate', cert: 'wildcard.internal.bank', minutes: 240, impact: 'outage', customers: 410000, reassignments: 3, detail: 'Certificate expired at 03:00 on a Friday; renewed by hand the same morning', teams: ['Cloud Platform', 'Payments Platform', 'Core Banking', 'Cards'], affected: ['api-gateway', 'service-mesh', 'auth-gateway', 'payment-orchestrator', 'card-auth-svc', 'ledger-svc']}
] AS row
MERGE (i:Incident {id: row.id})
SET i.severity = row.sev, i.started_at = datetime(row.at), i.title = row.title,
    i.duration_minutes = row.minutes, i.impact = row.impact, i.customers_impacted = row.customers,
    i.reassignments = row.reassignments, i.detail = row.detail
WITH i, row
MATCH (c:Certificate {name: row.cert})
MERGE (i)-[:ROOT_CAUSE]->(c)
WITH i, row
UNWIND row.teams AS tn
MATCH (t:Team {name: tn})
MERGE (i)-[:ASSIGNED_TO]->(t)
WITH DISTINCT i, row
UNWIND row.affected AS sn
MATCH (s:Service {name: sn})
MERGE (i)-[:AFFECTED]->(s);

// ---- tonight's alert storm ----
UNWIND [
  {id: 'ALR-77120', at: '2026-09-30T03:07:00Z', comp: 'profile-cache', summary: 'profile-cache p99 latency 4.2s, hit rate 31% and falling'},
  {id: 'ALR-77121', at: '2026-09-30T03:08:00Z', comp: 'customer-profile-svc', summary: 'customer-profile-svc p99 latency 2.9s'},
  {id: 'ALR-77122', at: '2026-09-30T03:08:00Z', comp: 'image-store', summary: 'image-store disk usage 78%'},
  {id: 'ALR-77123', at: '2026-09-30T03:09:00Z', comp: 'entitlements-svc', summary: 'entitlements-svc error rate 6%'},
  {id: 'ALR-77124', at: '2026-09-30T03:09:00Z', comp: 'auth-gateway', summary: 'auth-gateway 5xx rate 4%'},
  {id: 'ALR-77125', at: '2026-09-30T03:10:00Z', comp: 'wire-svc', summary: 'wire-svc submission timeouts'},
  {id: 'ALR-77126', at: '2026-09-30T03:10:00Z', comp: 'wire-svc', summary: 'wire-svc retry storm: queue depth 4x'},
  {id: 'ALR-77127', at: '2026-09-30T03:11:00Z', comp: 'sanctions-screening', summary: 'sanctions-screening latency above SLO'},
  {id: 'ALR-77128', at: '2026-09-30T03:11:00Z', comp: 'logs-index', summary: 'logs-index disk usage 81%'},
  {id: 'ALR-77129', at: '2026-09-30T03:11:00Z', comp: 'settlement-db', summary: 'settlement-db replication lag 40s'},
  {id: 'ALR-77130', at: '2026-09-30T03:12:00Z', comp: 'bill-pay-svc', summary: 'bill-pay-svc error rate 9%'},
  {id: 'ALR-77131', at: '2026-09-30T03:12:00Z', comp: 'email-gateway', summary: 'email-gateway bounce rate 3%'},
  {id: 'ALR-77132', at: '2026-09-30T03:12:00Z', comp: 'campaign-svc', summary: 'campaign-svc audience refresh failing'},
  {id: 'ALR-77133', at: '2026-09-30T03:13:00Z', comp: 'mobile-bff', summary: 'mobile-bff login failures rising'},
  {id: 'ALR-77134', at: '2026-09-30T03:13:00Z', comp: 'atm-journal-db', summary: 'atm-journal-db connections at 85% of pool'},
  {id: 'ALR-77135', at: '2026-09-30T03:13:00Z', comp: 'trade-finance-svc', summary: 'trade-finance-svc end-of-day batch late'},
  {id: 'ALR-77136', at: '2026-09-30T03:14:00Z', comp: 'agent-desktop-svc', summary: 'agent-desktop-svc slow screen pops'},
  {id: 'ALR-77137', at: '2026-09-30T03:14:00Z', comp: 'push-gateway', summary: 'push-gateway delivery latency 2x'},
  {id: 'ALR-77138', at: '2026-09-30T03:14:00Z', comp: 'metrics-tsdb', summary: 'metrics-tsdb ingestion lag 90s'}
] AS row
MERGE (a:Alert {id: row.id})
SET a.fired_at = datetime(row.at), a.summary = row.summary
WITH a, row
MATCH (c:Component {name: row.comp})
MERGE (a)-[:FIRED_ON]->(c);

// ---- summary ----
MATCH (n) RETURN count(n) AS nodes, COUNT { ()-[]->() } AS relationships;
