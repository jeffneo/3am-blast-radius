] AS row
MERGE (c:Change {id: row.id})
SET c.deployed_at = datetime(row.at), c.what = row.what, c.risk_review = row.review
WITH c, row
MATCH (s:Service {name: row.svc})
MERGE (c)-[:DEPLOYED_TO]->(s);

