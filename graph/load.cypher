] AS row
MERGE (i:Incident {id: row.id})
SET i.severity = row.sev, i.started_at = datetime(row.at), i.title = row.title,
    i.duration_minutes = row.minutes, i.impact = row.impact, i.customers_impacted = row.customers,
    i.reassignments = row.reassignments, i.detail = row.detail
WITH i, row
MATCH (t:Team {name: row.team})
MERGE (i)-[:ASSIGNED_TO]->(t);

